        }
    },
    "installer": {
        "script": [
            "# Remove stale StarNet registration so the NSIS upgrade hook does not redirect installation to an older Scoop directory.",
            "Remove-Item 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\StarNet' -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item 'HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\StarNet' -Recurse -Force -ErrorAction SilentlyContinue",
            "Start-Process \"$dir\\starnet-setup.exe\" -ArgumentList '/S', \"/D=$dir\" -Wait"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\uninstall.exe\") {",
            "    Start-Process \"$dir\\uninstall.exe\" -ArgumentList '/S' -Wait",
            "}"
        ]
    },
    "shortcuts": [
        [
            "skynet-desktop.exe",
            "StarNet"
        ]
    ],
    "checkver": {
        "github": "https://github.com/androoAGI/starnet-releases"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/androoAGI/starnet-releases/releases/download/v$version/StarNet_$version_x64-setup.exe#/starnet-setup.exe"
            }
        }
    }
}
