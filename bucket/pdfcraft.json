    "description": "Native PDF workbench for reading, organizing, combining and protecting PDFs",
    "homepage": "https://github.com/storytold/pdfcraft",
    "license": "MIT|Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/pdfcraft/releases/download/v0.9.0/pdfcraft-0.9.0-windows-x64-portable.zip",
            "hash": "e09f5bb89ab830e3f123a8779e28e203aef243a23997586c68a67d5b4995f429",
            "extract_dir": "pdfcraft-0.9.0-windows-x64-portable"
        },
        "32bit": {
            "url": "https://github.com/storytold/pdfcraft/releases/download/v0.9.0/pdfcraft-0.9.0-windows-x86-portable.zip",
            "hash": "7233f967e7cb124f7a58e68c89c16a28843d4150fc10770ee9756b7259e375f7",
            "extract_dir": "pdfcraft-0.9.0-windows-x86-portable"
        },
        "arm64": {
            "url": "https://github.com/storytold/pdfcraft/releases/download/v0.9.0/pdfcraft-0.9.0-windows-arm64-portable.zip",
            "hash": "9931e148990166a8a36be62c20c065493bb8d89049c9a408a885e2dc2b7d88e4",
            "extract_dir": "pdfcraft-0.9.0-windows-arm64-portable"
        }
    },
    "bin": [
        "pdfcraft.exe",
        "pdfcraft-cli.exe"
    ],
    "shortcuts": [
        [
            "pdfcraft.exe",
            "PdfCraft"
        ]
    ],
    "post_install": [
        "$exe = Join-Path $dir 'pdfcraft.exe'",
        "$currentExe = Join-Path (Split-Path $dir -Parent) 'current\\pdfcraft.exe'",
        "if (Test-Path $currentExe) { $exe = $currentExe }",
        "$progId = 'HKCU:\\Software\\Classes\\Scoop.PdfCraft.PDF'",
        "$capabilities = 'HKCU:\\Software\\Scoop\\Apps\\PdfCraft\\Capabilities'",
        "$application = 'HKCU:\\Software\\Classes\\Applications\\pdfcraft.exe'",
        "New-Item \"$application\\shell\\open\\command\", \"$application\\SupportedTypes\", \"$application\\DefaultIcon\", \"$progId\\Application\" -Force | Out-Null",
        "New-ItemProperty $application -Name FriendlyAppName -Value 'PdfCraft (Scoop)' -PropertyType String -Force | Out-Null",
        "New-ItemProperty \"$application\\SupportedTypes\" -Name '.pdf' -Value '' -PropertyType String -Force | Out-Null",
        "Set-Item \"$application\\shell\\open\\command\" -Value ('\"{0}\" \"%1\"' -f $exe)",
        "Set-Item \"$application\\DefaultIcon\" -Value ('\"{0}\",0' -f $exe)",
        "New-ItemProperty \"$progId\\Application\" -Name ApplicationName -Value 'PdfCraft (Scoop)' -PropertyType String -Force | Out-Null",
        "New-Item \"$progId\\shell\\open\\command\", \"$progId\\DefaultIcon\", \"$capabilities\\FileAssociations\", 'HKCU:\\Software\\Classes\\.pdf\\OpenWithProgids', 'HKCU:\\Software\\RegisteredApplications' -Force | Out-Null",
        "Set-Item $progId -Value 'PDF document'",
        "Set-Item \"$progId\\shell\\open\\command\" -Value ('\"{0}\" \"%1\"' -f $exe)",
        "Set-Item \"$progId\\DefaultIcon\" -Value ('\"{0}\",0' -f $exe)",
        "New-ItemProperty 'HKCU:\\Software\\Classes\\.pdf\\OpenWithProgids' -Name 'Scoop.PdfCraft.PDF' -Value '' -PropertyType String -Force | Out-Null",
        "New-ItemProperty $capabilities -Name ApplicationName -Value 'PdfCraft (Scoop)' -PropertyType String -Force | Out-Null",
        "New-ItemProperty $capabilities -Name ApplicationDescription -Value 'Read, organize, combine and protect PDFs with PdfCraft.' -PropertyType String -Force | Out-Null",
        "New-ItemProperty \"$capabilities\\FileAssociations\" -Name '.pdf' -Value 'Scoop.PdfCraft.PDF' -PropertyType String -Force | Out-Null",
        "New-ItemProperty 'HKCU:\\Software\\RegisteredApplications' -Name 'PdfCraft (Scoop)' -Value 'Software\\Scoop\\Apps\\PdfCraft\\Capabilities' -PropertyType String -Force | Out-Null",
        "if (-not ('Scoop.PdfCraftShell' -as [type])) { Add-Type -Namespace Scoop -Name PdfCraftShell -MemberDefinition '[System.Runtime.InteropServices.DllImport(\"shell32.dll\")] public static extern void SHChangeNotify(uint eventId, uint flags, System.IntPtr item1, System.IntPtr item2);' }",
        "[Scoop.PdfCraftShell]::SHChangeNotify(0x08000000, 0, [IntPtr]::Zero, [IntPtr]::Zero)"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    $application = 'HKCU:\\Software\\Classes\\Applications\\pdfcraft.exe'",
        "    $openCommand = Get-Item \"$application\\shell\\open\\command\" -ErrorAction SilentlyContinue",
        "    $appRoot = Split-Path $dir -Parent",
        "    if ($openCommand -and $openCommand.GetValue('').StartsWith(('\"{0}\\' -f $appRoot), [StringComparison]::OrdinalIgnoreCase)) { Remove-Item $application -Recurse -Force }",
        "    Remove-Item 'HKCU:\\Software\\Classes\\Scoop.PdfCraft.PDF', 'HKCU:\\Software\\Scoop\\Apps\\PdfCraft' -Recurse -Force -ErrorAction SilentlyContinue",
        "    Remove-ItemProperty 'HKCU:\\Software\\Classes\\.pdf\\OpenWithProgids' -Name 'Scoop.PdfCraft.PDF' -Force -ErrorAction SilentlyContinue",
        "    Remove-ItemProperty 'HKCU:\\Software\\RegisteredApplications' -Name 'PdfCraft (Scoop)' -Force -ErrorAction SilentlyContinue",
        "    if (-not ('Scoop.PdfCraftShell' -as [type])) { Add-Type -Namespace Scoop -Name PdfCraftShell -MemberDefinition '[System.Runtime.InteropServices.DllImport(\"shell32.dll\")] public static extern void SHChangeNotify(uint eventId, uint flags, System.IntPtr item1, System.IntPtr item2);' }",
        "    [Scoop.PdfCraftShell]::SHChangeNotify(0x08000000, 0, [IntPtr]::Zero, [IntPtr]::Zero)",
        "}"
    ],
    "notes": "PDF support is registered for the current Windows user. To make PdfCraft the default, open Settings > Apps > Default apps and select PdfCraft (Scoop). Windows requires this one-time choice.",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/pdfcraft/releases/download/v$version/pdfcraft-$version-windows-x64-portable.zip",
                "extract_dir": "pdfcraft-$version-windows-x64-portable"
            },
            "32bit": {
                "url": "https://github.com/storytold/pdfcraft/releases/download/v$version/pdfcraft-$version-windows-x86-portable.zip",
                "extract_dir": "pdfcraft-$version-windows-x86-portable"
            },
            "arm64": {
                "url": "https://github.com/storytold/pdfcraft/releases/download/v$version/pdfcraft-$version-windows-arm64-portable.zip",
                "extract_dir": "pdfcraft-$version-windows-arm64-portable"
            }
        },
        "hash": {
            "url": "https://github.com/storytold/pdfcraft/releases/download/v$version/SHA256SUMS.txt"
        }
    }
}
